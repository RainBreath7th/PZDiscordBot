# Required. Discord bot token.
DISCORD_TOKEN=

# Required. Source RCON coordinates of the existing PZ server.
# No defaults — write them yourself. What you put in RCON_HOST depends
# on which compose file you start (see the comments on each file):
#
#   compose.bot.yaml         → PZ compose service name (e.g. pz-server)
#   compose.bot.remote.yaml  → PZ host LAN IP (e.g. 10.0.0.5)
#   compose.bot.native.yaml  → host.docker.internal  (same machine)
#                              or a LAN IP            (PZ on another host)
#   python -m bot            → 127.0.0.1 or the real IP
RCON_HOST=
RCON_PORT=
RCON_PASSWORD=

# Required by compose.bot.yaml only (PZ container on the same host).
# External Docker network that already contains the PZ server.
# The Python process does not read this variable; remote / native
# compose files do not use it either.
BOT_NETWORK=

# Optional runtime tunables.
POLL_INTERVAL=30
RESTART_TIMEOUT=7200
RESTART_GRACE=360
RCON_FAIL_THRESHOLD=3
EMPTY_CONFIRM_SECONDS=10
RCON_TIMEOUT=10
CONFIG_DIR=/app/config
HEALTH_STATE_PATH=/tmp/pz-bot-health.json
LOG_LEVEL=INFO
