# Required. Discord bot token.
DISCORD_TOKEN=

# Required. Source RCON coordinates of the existing PZ container.
# No defaults — set the compose service hostname and port yourself.
RCON_HOST=
RCON_PORT=
RCON_PASSWORD=

# Required by compose.bot.yaml only. External Docker network that already
# contains the PZ server. The Python process does not read this variable.
BOT_NETWORK=

# Optional runtime tunables.
POLL_INTERVAL=30
RESTART_TIMEOUT=7200
RESTART_GRACE=360
RCON_FAIL_THRESHOLD=3
EMPTY_CONFIRM_SECONDS=10
RCON_TIMEOUT=10
CONFIG_DIR=/app/config
HEALTH_STATE_PATH=/tmp/pz-bot-health.json
LOG_LEVEL=INFO
